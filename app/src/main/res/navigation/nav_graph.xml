<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/convFragment">

    <!-- 대화 목록 -->
    <fragment
        android:id="@+id/convFragment"
        android:name="com.example.smsapp.ui.conversation.ConvFragment">
        <action
            android:id="@+id/action_convFragment_to_threadFragment"
            app:destination="@id/threadFragment" />
        <action
            android:id="@+id/action_convFragment_to_settingsFragment"
            app:destination="@id/settingsFragment" />
    </fragment>

    <!-- 스팸함 -->
    <fragment
        android:id="@+id/spamFragment"
        android:name="com.example.smsapp.ui.spam.SpamFragment">
        <action
            android:id="@+id/action_spamFragment_to_threadFragment"
            app:destination="@id/threadFragment" />
    </fragment>

    <!-- 스레드 -->
    <fragment
        android:id="@+id/threadFragment"
        android:name="com.example.smsapp.ui.thread.ThreadFragment">
        <argument
            android:name="address"
            app:argType="string" />
        <argument
            android:name="isSpam"
            app:argType="boolean"
            android:defaultValue="false" />
    </fragment>

    <!-- ✅ Settings → Keyword 로 가는 새 액션 -->
    <fragment
        android:id="@+id/settingsFragment"
        android:name="com.example.smsapp.ui.settings.SettingsFragment">
        <action
            android:id="@+id/action_settingsFragment_to_keywordFragment"
            app:destination="@id/keywordFragment" />
    </fragment>

    <!-- 키워드 관리 -->
    <fragment
        android:id="@+id/keywordFragment"
        android:name="com.example.smsapp.ui.keyword.KeywordFragment">
        <argument
            android:name="isWhitelist"
            app:argType="boolean"
            android:defaultValue="false" />
    </fragment>
</navigation>
